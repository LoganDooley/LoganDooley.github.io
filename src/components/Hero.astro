---
import { SITE } from "../site";
import TrailMap from "./TrailMap.astro";
---

<section class="hero">
    <div class="panel hero-card">
        <h1>{SITE.name}</h1>
        <p class="role">{SITE.role}</p>
        <p class="tagline">{SITE.tagline}</p>
        <ul class="link-row">
            {SITE.links.map((link) => (
                <li><a class="button" href={link.href}>{link.label}</a></li>
            ))}
        </ul>
    </div>
    <TrailMap />
</section>

<style>
    .hero {
        min-height: 70vh;
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        align-items: flex-start;
        gap: 1rem;
        padding-top: 2rem;
    }

    .hero-card {
        max-width: 32rem;
    }

    h1 {
        margin: 0;
        font-size: 2.5rem;
        line-height: 1.1;
    }

    .role {
        margin: 0.25rem 0 1rem;
        color: var(--accent);
        font-weight: 600;
    }

    .tagline {
        margin: 0 0 1.25rem;
        color: var(--text-muted);
    }

    .link-row {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        list-style: none;
        margin: 0;
        padding: 0;
    }
</style>